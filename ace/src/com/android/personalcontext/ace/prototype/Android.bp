package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "personalcontext_ace_prototype_utils",
    srcs: [
        "PrototypeHintUtils.kt",
        "PrototypeInsightUtils.kt",
    ],
    manifest: "AndroidManifest.xml",
    static_libs: [
        "personalcontext_ace_prototype_hint",
        "personalcontext_ace_prototype_insight",
        "personalcontext_ace_prototype_aacard",
        "personalcontext_ace_prototype_call",
        "personalcontext_ace_prototype_card",
        "personalcontext_ace_prototype_clientaction",
        "personalcontext_ace_prototype_crossdevice_intent",
        "personalcontext_ace_prototype_embeddedscroll",
        "personalcontext_ace_prototype_empty",
        "personalcontext_ace_prototype_example",
        "personalcontext_ace_prototype_grid",
        "personalcontext_ace_prototype_serversideclose",
        "personalcontext_ace_prototype_weather",
    ],
}

android_library {
    name: "personalcontext_ace_prototype_hint",
    srcs: ["PrototypeHint.kt"],
    manifest: "AndroidManifest.xml",
    static_libs: ["androidx.annotation_annotation"],
}

android_library {
    name: "personalcontext_ace_prototype_insight",
    srcs: ["PrototypeInsight.kt"],
    manifest: "AndroidManifest.xml",
    static_libs: ["androidx.annotation_annotation"],
}
